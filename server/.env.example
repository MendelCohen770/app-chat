# Required: MongoDB connection string.
DB_CONNECTION=mongodb://127.0.0.1:27017/app-chat

# Required: Secret used to sign and verify JWT tokens (minimum 15 chars).
JWT_SECRET=replace_with_a_long_random_secret

# Required: Frontend origin used for CORS and CSP.
CLIENT_ORIGIN=http://localhost:5173

# Required: Google OAuth client id for Google login token verification.
GOOGLE_CLIENT_ID=your_google_client_id_here

# Optional: HTTP server port.
PORT=3000

# Optional: Extra CORS origins (comma-separated).
CORS_ORIGIN_WHITELIST=http://localhost:5173,http://127.0.0.1:5173

# Optional: Graceful shutdown timeout in milliseconds.
SHUTDOWN_TIMEOUT_MS=10000

# Optional: Runtime environment.
NODE_ENV=development

# Optional: Logger level (trace, debug, info, warn, error, fatal).
LOG_LEVEL=debug

# Optional: Service name added to structured logs.
SERVICE_NAME=app-chat-server

# Optional: SMTP sender address for OTP emails.
EMAIL=your_email@gmail.com

# Optional: SMTP app password for OTP emails.
EMAIL_PASSWORD=your_email_app_password
