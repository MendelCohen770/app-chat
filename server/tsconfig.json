{
  "compilerOptions": {
    "typeRoots": ["./node_modules/@types", "./src/utils"],
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "removeComments": true
  },
  "include": ["./src/**/*.ts", "./src/utils/**/*.ts", "../shared/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.test.ts"]
}